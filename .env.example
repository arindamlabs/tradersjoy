# Copy this file to .env and fill in real values. .env is gitignored.

# Alpaca paper-trading credentials
# Get these from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Use the paper-trading endpoint until we explicitly graduate to live.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Local SQLite store for bars, trades, positions, equity curve.
DATABASE_URL=sqlite:///data/tradersjoy.sqlite

# Where the run journal and automation heartbeat live. Leave unset locally and
# they share the file above. Ephemeral deployments (the GitHub Actions runner)
# point this at a small separate file, because the bars are disposable -- a
# fresh ingest rebuilds them in seconds -- but the journal is the track record
# and has to be carried between runs.
# JOURNAL_DATABASE_URL=sqlite:///state/journal.sqlite
