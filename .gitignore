# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual envs / uv
.venv/
venv/
env/

# Environment / secrets
.env
.env.local
.env.*.local

# Local data store at repo root (bars, SQLite) — never in git.
# Leading slash anchors this to the root so it doesn't match src/tradersjoy/data/.
/data/*

# ...with one exception: the deployed model artifact. An ephemeral CI runner has
# to get the model from somewhere, and versioning it next to the code that
# serves it is better practice than fetching a mystery binary at run time.
!/data/models/
/data/models/*
!/data/models/ml.joblib

*.sqlite
*.sqlite3
*.db

# The journal is the track record and IS committed (see .github/workflows/trade.yml).
!/state/
!/state/*.sqlite

# Unattended-run logs (rotated locally; never in git)
/logs/

# MLflow
mlruns/
mlartifacts/

# Generated API docs (built on demand with pdoc)
/docs/api/

# Editors / OS
.idea/
.vscode/
.DS_Store
*.swp

# Claude Code local-only settings
.claude/settings.local.json

# Jupyter
.ipynb_checkpoints/
